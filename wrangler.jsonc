{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azimjon-portfolio-3d",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
