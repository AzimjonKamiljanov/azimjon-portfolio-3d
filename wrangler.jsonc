{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azimjon-portfolio-3d",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Cloudflare Workers Builds runs this on every push to main and deploys
  // only if it exits 0. GitHub Actions does not deploy, so without the tests
  // here a red CI run would still have shipped. `verify` covers format, lint,
  // build and unit tests, and leaves the built dist/ in place for upload.
  "build": {
    "command": "npm run verify"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
