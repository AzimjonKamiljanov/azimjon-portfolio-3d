    "motion": "12.43.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
