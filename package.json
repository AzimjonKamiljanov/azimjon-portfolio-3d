{
  "name": "azimjon-portfolio-3d",
  "version": "1.1.0",
  "description": "3D Solar System Developer Portfolio",
  "type": "module",
  "license": "MIT",
  "author": "Azimjon Kamiljanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzimjonKamiljanov/azimjon-portfolio-3d.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --grep-invert @visual",
    "test:e2e:visual": "playwright test --grep @visual",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,cjs,mjs,jsx,json,css,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,jsx,json,css,md,yml}\"",
    "types": "wrangler types",
    "verify": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@mediapipe/camera_utils": "0.3.1675466862",
    "@mediapipe/hands": "0.4.1675469240",
    "@mediapipe/tasks-vision": "1.2.2",
    "gsap": "3.15.0",
    "motion": "12.43.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "prettier": "3.9.10",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
