{
  "name": "azimjon-portfolio-3d",
  "version": "1.1.0",
  "description": "3D Solar System Developer Portfolio",
  "type": "module",
  "license": "MIT",
  "author": "Azimjon Kamiljanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzimjonKamiljanov/azimjon-portfolio-3d.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/stamp-sitemap.mjs",
    "preview": "vite preview",
    "deploy": "npm run verify && wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --grep-invert @visual",
    "test:e2e:visual": "playwright test --grep @visual",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,cjs,mjs,jsx,json,css,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,jsx,json,css,md,yml}\"",
    "types": "wrangler types",
    "verify": "npm run format:check && npm run lint && npm run build && npm run test && npm run budget",
    "budget": "node scripts/bundle-budget.mjs",
    "measure": "node scripts/measure-fps.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "gsap": "3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "eslint": "^10.15.0",
    "globals": "17.14.0",
    "motion": "^12.43.0",
    "prettier": "3.10.1",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "wrangler": "4.158.0",
    "ws": "8.18.3"
  }
}
